# ============================================================
# MySQL database - REQUIRED
# RightPolamRight does not use SQLite.
# ============================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rightpolamright
MYSQL_USER=rightpolamright_user
MYSQL_PASSWORD=replace-with-a-strong-mysql-password

# JWT signing key. Use a long random value outside local development.
SECRET_KEY=replace-with-a-long-random-secret

# Optional first-admin bootstrap.
RPR_ADMIN_EMAIL=admin@example.com
RPR_ADMIN_PASSWORD=replace-with-a-strong-password
RPR_ADMIN_NAME=RightPolamRight Admin
RPR_ADMIN_MOBILE=replace-with-admin-mobile-number

# Google Maps Platform
GOOGLE_MAPS_API_KEY=replace-with-server-restricted-google-maps-key
VITE_GOOGLE_MAPS_API_KEY=replace-with-browser-restricted-google-maps-key
