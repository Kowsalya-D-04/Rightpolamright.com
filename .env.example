# Backend database (optional; defaults to backend/rightpolamright.db)
# DATABASE_URL=sqlite:///C:/path/to/rightpolamright.db

# JWT signing key. Use a long random value outside local development.
SECRET_KEY=replace-with-a-long-random-secret

# Optional first-admin bootstrap. Set these in Command Prompt before start.bat.
RPR_ADMIN_EMAIL=admin@example.com
RPR_ADMIN_PASSWORD=replace-with-a-strong-password
RPR_ADMIN_NAME=RightPolamRight Admin
